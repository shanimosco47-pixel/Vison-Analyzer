# Example configuration for Video Analyzer.
#
# Every setting here is optional: the application runs with sensible defaults
# and no configuration at all.  To use this file:
#
#     set -a && source config.example.env && set +a     # Linux / macOS
#     python -m app.main
#
# On Windows PowerShell, set the variables individually:
#
#     $env:VISION_ANALYZER_DATA_DIR = "D:\video-analyzer-data"
#
# Command-line flags (python -m app.main --help) override these variables.
# Analysis thresholds are NOT set here - they are per-analysis and live in
# app/config.py (defaults) and in the browser UI (per run).

# --- Where data is stored ---------------------------------------------------
# Uploads, the rotating server log and (if enabled) diagnostic images.
# Point this at a disk with room for your recordings.
VISION_ANALYZER_DATA_DIR=~/.vision_analyzer

# Largest accepted upload, in megabytes. A 12 h 1080p H.264 recording is
# typically 8-20 GB, so raise this if you analyse whole shifts.
VISION_ANALYZER_MAX_UPLOAD_MB=4096

# Uploads untouched for this many hours are deleted automatically.
VISION_ANALYZER_RETENTION_HOURS=24

# How far a recording's presentation timestamps may drift from a single frame
# rate, in seconds, before the upload is refused rather than measured with
# growing error. Lower this for a measurement that needs tighter accuracy than
# the default guarantees; raise it if real footage that drops the occasional
# frame is being refused for drift that does not matter to your use case.
VISION_ANALYZER_MAX_TIMING_ERROR_S=0.05

# --- Server -----------------------------------------------------------------
# 127.0.0.1 means "this machine only", which is the intended deployment.
# Changing it exposes plant footage to your network: do so deliberately, and
# only on a trusted network, because the prototype has no authentication.
VISION_ANALYZER_HOST=127.0.0.1
VISION_ANALYZER_PORT=8000

# --- Diagnostics and logging ------------------------------------------------
# DEBUG logs every stage decision; INFO is the sensible default.
VISION_ANALYZER_LOG_LEVEL=INFO

# Write the frames at each detected event boundary, with the analysis region
# drawn on them, to <data dir>/diagnostics/<job id>/.  Invaluable when tuning
# thresholds against real footage; off by default because it writes many files.
VISION_ANALYZER_SAVE_DIAGNOSTICS=0

# Flask debug mode. Leave off: it exposes an interactive debugger.
VISION_ANALYZER_DEBUG=0
